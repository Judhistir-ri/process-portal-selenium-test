{
  "name": "process-selenium-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js --reporter mochawesome",
    "test_login": "mocha tests/login/login.test.js --reporter mochawesome",
    "test_global_search": "mocha tests/globalSearch/globalSearch.test.js --reporter mochawesome --reporter-options reportDir=reports/global-search,reportFilename=GlobalSearchReport,html=true,json=true,overwrite=true,quiet=true",
    "test_processor_portal": "mocha tests/all_tests/processorPortalAllTests.test.js --reporter mochawesome --reporter-options reportDir=reports/processor-portal,reportFilename=ProcessorPortalReport,html=true,json=true,overwrite=true",
    "test_create_new_order": "mocha tests/new/createNewOrder.test.js --reporter mochawesome --reporter-options reportDir=reports/new-order,reportFilename=CreateNewOrderReport,html=true,json=true,overwrite=true",
    
    "test_process": "mocha tests/process/process.test.js --reporter mochawesome --reporter-options reportDir=reports/process,reportFilename=ProcessReport,html=true,json=true,overwrite=true",  
    "test_create_new_order_email": "node utils/runTestsAndEmail.js tests/new/createNewOrder.test.js reports/new-order CreateNewOrderReport",
    "test_process_email": "node utils/runTestsAndEmail.js tests/process/process.test.js reports/process ProcessReport",
    
    "test_processor_portal_email": "node utils/runTestsAndEmail.js tests/all_tests/processorPortalAllTests.test.js reports/processor-portal ProcessorPortalReport",
    "test_global_search_email": "node utils/runTestsAndEmail.js tests/globalSearch/globalSearch.test.js reports/global-search GlobalSearchReport",
    
    "test_new_order_process_email": "node utils/runTestsAndEmail.js tests/all_tests/newOrderAndProcess.test.js reports/new-order-process NewOrderAndProcessReport",
    "test_processor_portal_allTest_email": "node utils/runTestsAndEmail.js tests/all_tests/processorPortalAndGlobalSearchMerge.test.js reports/processor-portal-global-search ProcessorPortalAndGlobalSearchMergeReport"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "nodemailer": "^10.6.0",
    "puppeteer": "^25.18.1",
    "selenium-webdriver": "^4.48.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^10.8.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
